MAIL_FROM=minilinkinfo@gmail.com
MAIL_FROM_NAME=MiniLink
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false